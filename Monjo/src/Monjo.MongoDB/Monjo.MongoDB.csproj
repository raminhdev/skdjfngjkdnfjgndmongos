<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Monjo.MongoDB</RootNamespace>
    <PackageId>Monjo.MongoDB</PackageId>
    <Version>1.0.0</Version>
    <Authors>Monjo</Authors>
    <Description>
      Monjo MongoDB provider: native MongoDB.Driver usage (reused MongoClient, cached collection
      handles, server-side filtering/sorting/pagination, bulk writes, native transactions on
      replica sets). Also carries the preserved Utilities.MongoDatabase legacy API so existing
      Mongo applications keep compiling and behaving exactly as before.
    </Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Monjo.Core\Monjo.Core.csproj" />
    <PackageReference Include="MongoDB.Driver" Version="3.4.2" />
  </ItemGroup>

</Project>
